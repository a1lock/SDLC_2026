# Скопируйте в .env и задайте собственные значения.

# Пароль PostgreSQL. Используйте только URL-безопасные символы (буквы, цифры, - _ .)
POSTGRES_PASSWORD=qwerty12345

# Ключ подписи JWT, не менее 32 символов. Пример: openssl rand -hex 32
JWT_SECRET=fgd87fgdfighfdgeyrbgnrgp9rg7bfihgndkljnkmkwnhbhvfr8fyer9fverfbienfelfu9wfbdikfjjnwfwgf9r
# Пароль — от 8 до 72 байт; логин — латиница, цифры, _ . - (3–50 символов).
ADMIN_LOGIN=admin
ADMIN_PASSWORD=adminpassword

# Необязательно
LOG_LEVEL=INFO
APP_TIMEZONE=Europe/Moscow
